{
  "name": "dsh-torso",
  "version": "0.1.0",
  "private": true,
  "description": "Torso：画布式分镜台，镜头脚本 + 首尾帧出图 + 第三方视频 API 出片",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "鲍柳涛",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "storyboard",
